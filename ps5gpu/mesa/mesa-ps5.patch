index 0000000..a0262da
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/Rasterizer.cpp
@@ -0,0 +1,287 @@
+/**************************************************************************
+ *
+ * Copyright 2012-2021 VMware, Inc.
+ * All Rights Reserved.
+ *
