+static void
+ps5_draw_cursor(uint8_t *pixels, uint32_t width, uint32_t height, uint32_t row_bytes)
+{
+   enum { MAXC = 64 };
+   static HCURSOR cached;
+   static uint32_t shape[MAXC * MAXC];
+   static int cw, ch, hot_x, hot_y;
+
+   CURSORINFO ci;
+   ci.cbSize = sizeof ci;
+   if (!GetCursorInfo(&ci) || !(ci.flags & CURSOR_SHOWING) || !ci.hCursor)
+      return;
+
+   if (ci.hCursor != cached) {
+      ICONINFO ii;
+      cw = ch = 0;
+      cached = ci.hCursor;
+      if (!GetIconInfo(ci.hCursor, &ii))
+         return;
+      BITMAP bm;
+      memset(&bm, 0, sizeof bm);
+      if (ii.hbmColor && GetObject(ii.hbmColor, sizeof bm, &bm)) {
+         cw = bm.bmWidth;
+         ch = bm.bmHeight;
+      } else if (ii.hbmMask && GetObject(ii.hbmMask, sizeof bm, &bm)) {
+         cw = bm.bmWidth;
+         ch = bm.bmHeight / 2;
+      }
+      hot_x = (int)ii.xHotspot;
+      hot_y = (int)ii.yHotspot;
+      if (ii.hbmColor)
+         DeleteObject(ii.hbmColor);
+      if (ii.hbmMask)
+         DeleteObject(ii.hbmMask);
+      if (cw > MAXC)
+         cw = MAXC;
+      if (ch > MAXC)
+         ch = MAXC;
+      if (cw <= 0 || ch <= 0) {
+         cw = ch = 0;
+         return;
+      }
+
+      BITMAPINFO info;
+      memset(&info, 0, sizeof info);
+      info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+      info.bmiHeader.biWidth = MAXC;
+      info.bmiHeader.biHeight = -MAXC;
+      info.bmiHeader.biPlanes = 1;
+      info.bmiHeader.biBitCount = 32;
+      info.bmiHeader.biCompression = BI_RGB;
+      uint32_t *bits = NULL;
+      HDC dc = CreateCompatibleDC(NULL);
+      HBITMAP dib = dc ? CreateDIBSection(dc, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0) : NULL;
+      if (!dib || !bits) {
+         if (dc)
+            DeleteDC(dc);
+         cw = ch = 0;
