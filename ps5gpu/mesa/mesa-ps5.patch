+ps5_covers_screen(struct wsi_win32_swapchain *chain, struct wsi_win32_image *image)
+{
+   static int enabled = -1;
+   if (enabled < 0) {
+      const char *e = getenv("PS5GPU_SCANOUT");
+      enabled = !(e && e[0] == '0');
+   }
+   if (!enabled)
+      return false;
+   uint32_t w, h, pitch;
+   if (ps5gpu_scanout_size(&w, &h, &pitch))
+      return false;
+   if (chain->extent.width != w || chain->extent.height != h ||
+       image->base.row_pitches[0] != pitch * 4 || !image->base.cpu_map)
+      return false;
+   HWND top = GetAncestor(chain->wnd, GA_ROOT);
+   if (!top || GetForegroundWindow() != top || IsIconic(top))
+      return false;
+   RECT rc;
+   POINT origin = { 0, 0 };
+   if (!GetClientRect(chain->wnd, &rc) || !ClientToScreen(chain->wnd, &origin))
+      return false;
+   return origin.x == 0 && origin.y == 0 && rc.right == (LONG)w && rc.bottom == (LONG)h;
