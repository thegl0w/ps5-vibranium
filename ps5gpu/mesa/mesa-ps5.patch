+/*
+ * Resource.h --
+ *    Functions that manipulate GPU resources.
+ */
+
+#ifndef RESOURCE_H
+#define RESOURCE_H
+
+#include "DriverIncludes.h"
+
+SIZE_T APIENTRY CalcPrivateResourceSize(
+   D3D10DDI_HDEVICE hDevice,
