; ps5wddm: WDDM driver for the PS5's GPU, release package (WDDM 2.0 by default, 1.3 selectable; OpenGL ICD since 1.3). MIT licence.
; DriverVer is chosen high (31.x) so games' AMD minimum-driver checks pass; it is not an AMD driver version.
; The second hardware ID is QEMU's standard VGA card, for rehearsals in a VM.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/25/2026,31.0.1125.20
CatalogFile=ps5wddm.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
ps5wddm.sys=1

[Manufacturer]
%Provider%=Models,NTamd64

[Models.NTamd64]
%NamePs5%=Install, PCI\VEN_1002&DEV_13FC
%NameVm%=Install, PCI\VEN_1234&DEV_1111

[Install]
FeatureScore=F9
CopyFiles=Files
AddReg=SoftwareSettings

[Files]
ps5wddm.sys

; Message-signalled interrupt: this machine cannot route the GPU's interrupt line, and without MSI Windows reports a
; resource conflict (problem 12) and the driver never starts. Same setting that fixed the HDMI audio function.
[Install.HW]
AddReg=Msi

[Msi]
HKR,"Interrupt Management",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",,0x00000010
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MSISupported,0x00010001,1

[SoftwareSettings]
HKR,,VgaCompatible,0x00010001,0
; A full graphics driver names its user-mode halves here (Direct3D 9, 10, 11, 12). Test value for now: a file that
; does not exist, to see whether Windows wants the entry at all before it starts the adapter.
; slots: Direct3D 9, 10, 11, 12. Slot 4 = the native Direct3D 12 driver (used in WDDM 2.0 mode).
HKR,,UserModeDriverName,0x00010000,"C:\ps5\gpu\d3d10\libgallium_d3d10.dll","C:\ps5\gpu\d3d10\libgallium_d3d10.dll","C:\ps5\gpu\d3d10\libgallium_d3d10.dll","C:\ps5\gpu\d3d12umd\ps5d3d12.dll"
HKR,,UserModeDriverNameWow,0x00010000,"ps5umd_none.dll","ps5umd_none.dll","ps5umd_none.dll","C:\ps5\gpu\d3d12umd32\ps5d3d12.dll"
; OpenGL (since 1.3): Mesa's OpenGL-on-Vulkan (Zink) as the system OpenGL driver (ICD), 64- and 32-bit. Windows' own
; opengl32.dll hands every OpenGL program to it, also games that only load DLLs from System32 (some older engines).
; The *Wow values are read for 32-bit programs; without OpenGLVersionWow they fell back to Microsoft's GDI Generic 1.1.
HKR,,OpenGLDriverName,0x00010000,"C:\ps5\gpu\gl\libgallium_wgl.dll"
HKR,,OpenGLDriverNameWow,0x00010000,"C:\ps5\gpu\gl32\libgallium_wgl.dll"
HKR,,OpenGLVersion,0x00010001,1
HKR,,OpenGLFlags,0x00010001,1
HKR,,OpenGLVersionWow,0x00010001,1
HKR,,OpenGLFlagsWow,0x00010001,1
HKR,,InstalledDisplayDrivers,0x00010000,"libgallium_d3d10","libgallium_d3d10","libgallium_d3d10","libgallium_d3d10"

[Install.Services]
AddService=ps5wddm,0x00000002,Service

[Service]
DisplayName=%NamePs5%
ServiceType=1
StartType=3
ErrorControl=0
LoadOrderGroup=Video
ServiceBinary=%12%\ps5wddm.sys
AddReg=ServiceSettings

; WDDM 2.0 (GPU MMU, native Direct3D 12) as the persistent default. Recovery: DefaultVersion=13 (reg add
; HKLM\SYSTEM\CurrentControlSet\Services\ps5wddm /v DefaultVersion /t REG_DWORD /d 13 /f, then restart). A 2.0 start
; that never became trusted falls back to 1.3 on its own at the next start (counted in Wddm2Fallbacks).
[ServiceSettings]
HKR,,DefaultVersion,0x00010001,20

[Strings]
Provider="PS5 GPU project"
Disk="ps5wddm files"
NamePs5="PS5 GPU (ps5wddm)"
NameVm="ps5wddm rehearsal on QEMU VGA"
