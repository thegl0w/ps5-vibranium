// Boot 13-15: install the kernel stub (windows_kstub.inc, generated by make_kstub.py) into the loaded ntoskrnl.
// Runs in the same places as the HAL patch, after it. The image is located from the HAL probe hit and accepted only
// when the PE header, the bytes before the slack, the zero slack and every hooked prologue match the build we analysed.
// 2026-11-22: those checks compare FNV-1a fingerprints, and the instructions each hook displaces are copied from the
// loaded kernel into the stub's trampoline slots here, at boot: our files hold no bytes of the kernel.
#include "WindowsKstub.h"
#include <Library/IoLib.h>
#include <Protocol/PciIo.h>

STATIC UINT32 mKstubMode;          // 0 off, 1 GPU window (PS5), 2 debugcon (VM)
STATIC UINT32 mKstubFbOff, mKstubPitch;
STATIC BOOLEAN mKstubForceDebugcon;
STATIC BOOLEAN mKstubForceGpuTest;      // VM only: exercise the GPU drawing path (ports go nowhere in QEMU)
STATIC UINT64 mKstubBase;
STATIC EFI_STATUS mKstubStatus = EFI_NOT_STARTED;
// Which hooks to install (bit = index in mKstubHooks: the crumbs in make_kstub.py's CRUMBS order, then KeBugCheck2,
// KiNmiInterrupt, KiPageFault). VM bisection builds set KSTUB_HOOK_MASK; the default installs all of them.
#ifndef KSTUB_HOOK_MASK
#define KSTUB_HOOK_MASK 0xFFFFFFFFFFFFFFFFULL
#endif
STATIC UINT64 mKstubHookMask = KSTUB_HOOK_MASK;

// Boot 16: Sony's custom Zen 2 has an EFER bit 16 ("xotext"): while it is set, a PTE with bit 58 is execute-only (reads and
// writes fault with a protection error). It is still set after the Linux hand-off. Windows keeps a working-set age in PTE
// bits 56-59, so its first page with age >= 4 faulted forever (boots 12-15). 0 not tried, 1 was already clear, 2 cleared,
// 3 write refused (#GP), 4 no CPU protocol/handler.
STATIC UINT32 mEferState;
STATIC UINT32 mKstubXoTest;                  // VM experiments only: cfg_xofix value 2 or 3 (see make_kstub.py)
STATIC UINT64 mEferBefore, mEferAfter;
STATIC UINT32 mKstubSampler = 0;             // NMI sampler (PERF_CTR0 overflow through LVTPC). Off since Boot 21: with several
                                             // processors each would sample and draw; turn it on again only for one-CPU hang hunts.
STATIC UINT32 mKstubPeriod = 0x80000000;     // PERF_CTR0 start = 0xFFFF:this, i.e. 2^31 unhalted cycles per sample

// Draw through the GPU port window, as the kernel stub does. Works before and after ExitBootServices.
STATIC VOID KstubPortRect (UINT32 X, UINT32 Y, UINT32 W, UINT32 H, UINT32 Colour)
{
  if (mKstubMode != 1) return;
  IoWrite32 (0x2018, 0);
  for (UINT32 R = 0; R < H; ++R) {
    for (UINT32 C = 0; C < W; ++C) {
      IoWrite32 (0x2000, (mKstubFbOff + (Y + R) * mKstubPitch + (X + C) * 4) | 0x80000000U);
      IoWrite32 (0x2004, Colour);
    }
  }
}

// PS5 GPU 20:00.0 (1002:13fc): I/O BAR 0x2000 = the first 256 bytes of the register space, so port 0x2000 = MM_INDEX,
// 0x2004 = MM_DATA, 0x2018 = MM_INDEX_HI. VRAM offset of the GOP framebuffer = FB - BAR0.
// Boot 13: Linux leaves MM_INDEX_HI = 1 (4 GiB of VRAM), so index bit 31 + offset addressed VRAM 2 GiB above the
// framebuffer and the check read 0. Checked on live Linux: with MM_INDEX_HI = 0 the port window reads the right words.
// Confirmed here by writing one framebuffer pixel directly and reading it back through the port window.
STATIC VOID KstubPickMode (EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop)
{
  EFI_HANDLE *Handles;
  UINTN Count;
  if (mKstubForceDebugcon) { mKstubMode = 2; return; }
  if (mKstubForceGpuTest) { mKstubMode = 1; mKstubFbOff = 0; mKstubPitch = 2560 * 4; return; }
  mKstubMode = 0;
  if (Gop == NULL || EFI_ERROR (gBS->LocateHandleBuffer (ByProtocol, &gEfiPciIoProtocolGuid, NULL, &Count, &Handles))) return;
  for (UINTN I = 0; I < Count; ++I) {
    EFI_PCI_IO_PROTOCOL *Pci;
    UINT32 Id = 0, B0 = 0, B1 = 0, B4 = 0, B5 = 0, Cmd = 0;
    if (EFI_ERROR (gBS->HandleProtocol (Handles[I], &gEfiPciIoProtocolGuid, (VOID **)&Pci))) continue;
    Pci->Pci.Read (Pci, EfiPciIoWidthUint32, 0, 1, &Id);
    if (Id != 0x13FC1002) continue;
    Pci->Pci.Read (Pci, EfiPciIoWidthUint32, 0x10, 1, &B0);
    Pci->Pci.Read (Pci, EfiPciIoWidthUint32, 0x14, 1, &B1);
    Pci->Pci.Read (Pci, EfiPciIoWidthUint32, 0x20, 1, &B4);
    Pci->Pci.Read (Pci, EfiPciIoWidthUint32, 0x24, 1, &B5);
    Pci->Pci.Read (Pci, EfiPciIoWidthUint32, 0x04, 1, &Cmd);
    UINT64 Bar0 = ((UINT64)B1 << 32) | (B0 & ~0xFULL);
    UINT64 Fb = Gop->Mode->FrameBufferBase;
    UINT64 Size = Gop->Mode->FrameBufferSize;
    TraceEvent ("GPU 1002:13fc BAR0 0x%Lx IO 0x%x BAR5 0x%x cmd/status 0x%x, GOP fb 0x%Lx size 0x%Lx ", Bar0, B4, B5, Cmd, Fb, Size);
    if ((B4 & ~3U) != 0x2000 || (B4 & 1) == 0 || Fb < Bar0 || Fb + Size > Bar0 + SIZE_256MB) break;
    // The register BAR (32-bit memory) gives a second view of MM_INDEX_HI, and a fallback way to clear it.
    volatile UINT32 *Reg = ((B5 & 0xF) == 0 && B5 >= 0x80000000U && (Cmd & 2) != 0) ? (volatile UINT32 *)(UINTN)B5 : NULL;
    UINT32 HiPort = IoRead32 (0x2018), HiMmio = Reg != NULL ? Reg[0x18 / 4] : 0xFFFFFFFF;
    TraceEvent ("GPU MM_INDEX 0x%x, MM_INDEX_HI before: port 0x%x, mmio 0x%x ", IoRead32 (0x2000), HiPort, HiMmio);
    IoWrite32 (0x2018, 0);
    if (IoRead32 (0x2018) != 0 && Reg != NULL) Reg[0x18 / 4] = 0;
    TraceEvent ("GPU MM_INDEX_HI after clearing: port 0x%x, mmio 0x%x ", IoRead32 (0x2018), Reg != NULL ? Reg[0x18 / 4] : 0xFFFFFFFF);
    mKstubFbOff = (UINT32)(Fb - Bar0);
    mKstubPitch = Gop->Mode->Info->PixelsPerScanLine * 4;
    volatile UINT32 *Last = (volatile UINT32 *)(UINTN)(Fb + Size - 4);
    UINT32 Saved = *Last;
    *Last = 0x5A13C0DE;
    IoWrite32 (0x2000, (mKstubFbOff + (UINT32)Size - 4) | 0x80000000U);
    UINT32 Seen = IoRead32 (0x2004);
    *Last = Saved;
    TraceEvent ("GPU window check: wrote 0x5A13C0DE, read 0x%x through port 0x2004 ", Seen);
    if (Seen == 0x5A13C0DE) {
#ifdef PS5_KSTUB_DRAW
      mKstubMode = 1;
      KstubPortRect (112, 1290, 56, 36, 0x00FF8000);    // orange: the firmware drew this through the port window
      // Boot 16, x = 184: cyan = EFER bit 16 was set and is now clear, white = it was already clear, red = could not clear it.
      KstubPortRect (184, 1290, 56, 36, mEferState == 2 ? 0x0000FFFF : mEferState == 1 ? 0x00FFFFFF : 0x00FF0000);
#else
      // Boot 29: the stub's squares, processor marks and stop-code digits stay off (they showed under the Windows logo);
      // Windows' own blue screen shows the stop code and its parameters (CrashControl DisplayParameters=1).
      TraceEvent ("Kernel stub drawing off (build with PS5_KSTUB_DRAW to see breadcrumbs) ");
#endif
    }
    break;
  }
  FreePool (Handles);
}

// Installer proposal (2026-11-21): one firmware for every kernel we have a stub for. WindowsKstub.h is generated by
// kstub_table.py from all windows_kstub*.inc files; the build is chosen by the image's own PE TimeDateStamp and
// SizeOfImage at the HAL probe hit, and every byte check below is the same as before, per build.
STATIC CONST KSTUB_BUILD *mKstubBuild;     // the build that matched (NULL = Not Found); named in the trace line

STATIC EFI_STATUS KstubInstall (VOID)
{
  UINT8 *Base = NULL;
  CONST KSTUB_BUILD *K = NULL;
  for (UINTN J = 0; J < ARRAY_SIZE (mKstubBuilds) && Base == NULL; ++J) {
    for (UINT32 H = 0; H < MIN (mHalPatchHits, 4U); ++H) {
      UINT8 *B = mHalHits[H] - mKstubBuilds[J].ProbeRva;
      if (((UINTN)B & 0xFFF) != 0 || B[0] != 'M' || B[1] != 'Z') continue;
      UINT32 E = *(UINT32 *)(B + 0x3C);
      if (E >= 0x1000 || *(UINT32 *)(B + E) != 0x00004550) continue;
      if (*(UINT32 *)(B + E + 8) != mKstubBuilds[J].Timestamp || *(UINT32 *)(B + E + 24 + 56) != mKstubBuilds[J].ImageSize) continue;
      Base = B;
      K = &mKstubBuilds[J];
    }
  }
  if (Base == NULL) return EFI_NOT_FOUND;
  mKstubBuild = K;
  mKstubBase = (UINT64)(UINTN)Base;
  if (HalFnv64 (Base + K->Rva - 16, 16) != K->Pre[0]) return EFI_COMPROMISED_DATA;
  for (UINTN I = 0; I < K->Slack; ++I) {
    if (Base[K->Rva + I] != 0) return EFI_ALREADY_STARTED;
  }
  for (UINTN I = 0; I < K->HookCount; ++I) {
    if (K->Hooks[I].Len < 5 || K->Hooks[I].Len > 16 || K->Hooks[I].RipCount > 2) return EFI_INCOMPATIBLE_VERSION;
    if (HalFnv64 (Base + K->Hooks[I].Rva, K->Hooks[I].Len) != K->Hooks[I].Hash) return EFI_INCOMPATIBLE_VERSION;
  }
  // Boot 15: second code area (slack after .text) and the recorder's scratch memory (end of .data's last page).
  for (UINTN I = 0; I < K->ExtSlack; ++I) {
    if (Base[K->ExtRva + I] != 0) return EFI_VOLUME_CORRUPTED;
  }
  for (UINTN I = 0; I < K->ScratchLen; ++I) {
    if (Base[K->ScratchRva + I] != 0) return EFI_VOLUME_FULL;
  }
  CopyMem (Base + K->ExtRva, K->Ext, K->ExtLen);
  UINT8 *Stub = Base + K->Rva;
  CopyMem (Stub, K->Blob, K->BlobLen);
  // Fill every trampoline slot with the instructions its hook displaces, straight from the kernel (still unpatched
  // here), and point RIP-relative operands back at their original targets: the slot runs at Rva + Disp, not at Rva.
  for (UINTN I = 0; I < K->HookCount; ++I) {
    CONST KSTUB_HOOK *Hk = &K->Hooks[I];
    CopyMem (Stub + Hk->Disp, Base + Hk->Rva, Hk->Len);
    for (UINTN R = 0; R < Hk->RipCount; ++R) {
      UINT8 *D = Stub + Hk->Disp + Hk->RipOff[R] + Hk->RipLen[R] - 4;
      INT32 V;
      CopyMem (&V, D, 4);
      V += (INT32)((INT64)Hk->Rva - (INT64)(K->Rva + Hk->Disp));
      CopyMem (D, &V, 4);
    }
  }
  *(UINT32 *)(Stub + KSTUB_CFG_MODE) = mKstubMode;
  *(UINT32 *)(Stub + KSTUB_CFG_FBOFF) = mKstubFbOff;
  *(UINT32 *)(Stub + KSTUB_CFG_PITCH) = mKstubPitch;
  *(UINT32 *)(Stub + KSTUB_CFG_SAMPLER) = mKstubSampler;
  *(UINT32 *)(Stub + KSTUB_CFG_PERIOD) = mKstubPeriod;
  *(UINT32 *)(Stub + KSTUB_CFG_XOFIX) = mKstubXoTest != 0 ? mKstubXoTest : (mEferState == 1 || mEferState == 2) ? 1 : 0;
  for (UINTN I = 0; I < K->HookCount; ++I) {
    if (I < 64 && ((mKstubHookMask >> I) & 1) == 0) continue;
    UINT8 *At = Base + K->Hooks[I].Rva;
    INT32 Rel = (INT32)((INT64)(K->Rva + K->Hooks[I].Tramp) - (INT64)(K->Hooks[I].Rva + 5));
    At[0] = 0xE9;
    CopyMem (At + 1, &Rel, 4);
    SetMem (At + 5, K->Hooks[I].Len - 5, 0x90);
  }
  return EFI_SUCCESS;
}

// Tier 1, pattern stub (KERNEL-PATTERN-STUDY.md, 2026-11-23): for a kernel the table above does not know. Everything is
// found in the loaded image itself, the same four checks as build/kpattern/kfind.py: the image (page-aligned MZ below the
// HAL probe hit whose SizeOfImage covers it), the entry point's 12 known bytes (KiSystemStartup), the unused tail of
// POOLCODE (zero or int3), and the HAL's local-APIC pointer through its two accessors (each exactly once, same variable).
// Installs make_kpat.py's ap_fix (PerfCtl MSRs, extended-APIC IERs, EFER bit 16) behind a jmp at the entry point; if any
// check fails it installs nothing and KstubRequire stops with the red screen as before.
#include "WindowsKpat.h"
STATIC BOOLEAN mKpatUsed;
STATIC UINT32  mKpatWhy;                     // 0 ok, 1 image, 2 entry bytes, 3 cave, 4 APIC accessors, 5 forced off
STATIC UINT32  mKpatEntryRva, mKpatCaveRva, mKpatCaveLen, mKpatApicRva;

STATIC EFI_STATUS KpatInstall (VOID)
{
  UINT8   *Base = NULL, *Sec, *Cave;
  UINT32  E, Size, I, O, RdHits = 0, WrHits = 0, Images = 0, Caves = 0;
  UINT64  RdVar = 0, WrVar = 0;
  INT32   D;
  // The HAL probe patch may find its block more than once in loader memory (7725: 2 hits). Exactly ONE of those hits
  // must lie inside a loaded PE image (page-aligned MZ below it whose SizeOfImage covers it); that image is the kernel.
  for (UINT32 H = 0; H < MIN (mHalPatchHits, 4U); ++H) {
    UINT8 *Hit = mHalHits[H], *Found = NULL;
    for (UINTN Back = 0; Back < SIZE_32MB && Found == NULL && Back <= ((UINTN)Hit & ~(UINTN)0xFFF); Back += SIZE_4KB) {
      UINT8 *B = (UINT8 *)(((UINTN)Hit & ~(UINTN)0xFFF) - Back);
      if (B[0] != 'M' || B[1] != 'Z') continue;
      E = *(UINT32 *)(B + 0x3C);
      if (E >= 0x1000 || *(UINT32 *)(B + E) != 0x00004550) continue;
      if ((UINTN)(Hit - B) < *(UINT32 *)(B + E + 24 + 56)) Found = B;
    }
    if (Found != NULL) { ++Images; Base = Found; }
  }
  if (Images != 1) { mKpatWhy = 1; return EFI_NOT_FOUND; }
  E = *(UINT32 *)(Base + 0x3C);
  Size = *(UINT32 *)(Base + E + 24 + 56);
  mKpatEntryRva = *(UINT32 *)(Base + E + 24 + 16);
  if (mKpatEntryRva + 12 > Size || CompareMem (Base + mKpatEntryRva, mKpatEntry, 12) != 0) { mKpatWhy = 2; return EFI_INCOMPATIBLE_VERSION; }
  Sec = Base + E + 24 + *(UINT16 *)(Base + E + 20);
  for (I = 0; I < *(UINT16 *)(Base + E + 6); ++I, Sec += 40) {
    UINT32 Va = *(UINT32 *)(Sec + 12), Vs = *(UINT32 *)(Sec + 8), Ch = *(UINT32 *)(Sec + 36);
    if (CompareMem (Sec, "POOLCODE", 8) != 0) continue;
    ++Caves;
    if ((Ch & 0x20000000) == 0 || (Ch & 0x02000000) != 0) continue;   // must be executable, not discardable
    mKpatCaveRva = (Va + Vs + 0xF) & ~0xFU;
    mKpatCaveLen = ((Va + Vs + 0xFFF) & ~0xFFFU) - mKpatCaveRva;
  }
  if (Caves != 1 || mKpatCaveLen < sizeof (mKpatBlob) || mKpatCaveRva + mKpatCaveLen > Size) { mKpatWhy = 3; return EFI_VOLUME_FULL; }
  for (I = 0; I < mKpatCaveLen; ++I) {
    if (Base[mKpatCaveRva + I] != 0 && Base[mKpatCaveRva + I] != 0xCC) { mKpatWhy = 3; return EFI_ALREADY_STARTED; }
  }
  // mov rax,[rip+d]; movsxd rdx,ecx; mov eax,[rdx+rax]; ret   and   mov rax,[rip+d]; movsxd r8,ecx; mov [r8+rax],edx; ret
  for (O = 0; O + 15 <= Size; ++O) {
    UINT8 *P = Base + O;
    if (P[0] != 0x48 || P[1] != 0x8B || P[2] != 0x05) continue;
    CopyMem (&D, P + 3, 4);
    if (P[7] == 0x48 && P[8] == 0x63 && P[9] == 0xD1 && P[10] == 0x8B && P[11] == 0x04 && P[12] == 0x02 && P[13] == 0xC3) {
      RdHits++; RdVar = (UINT64)((INT64)O + 7 + D);
    }
    if (P[7] == 0x4C && P[8] == 0x63 && P[9] == 0xC1 && P[10] == 0x41 && P[11] == 0x89 && P[12] == 0x14 && P[13] == 0x00 && P[14] == 0xC3) {
      WrHits++; WrVar = (UINT64)((INT64)O + 7 + D);
    }
  }
  if (RdHits != 1 || WrHits != 1 || RdVar != WrVar || RdVar + 8 > Size) { mKpatWhy = 4; return EFI_INCOMPATIBLE_VERSION; }
  mKpatApicRva = (UINT32)RdVar;
  // install: the blob in the cave, the displaced instructions and the way back in it, then the jmp at the entry point
  Cave = Base + mKpatCaveRva;
  CopyMem (Cave, mKpatBlob, sizeof (mKpatBlob));
  CopyMem (Cave + KPAT_OFF_MOVED, Base + mKpatEntryRva, KPAT_MOVED);
  D = (INT32)((INT64)(mKpatEntryRva + KPAT_MOVED) - (INT64)(mKpatCaveRva + KPAT_OFF_JMP_REL + 4));
  CopyMem (Cave + KPAT_OFF_JMP_REL, &D, 4);
  D = (INT32)((INT64)mKpatApicRva - (INT64)(mKpatCaveRva + KPAT_OFF_APIC_NEXT));
  CopyMem (Cave + KPAT_OFF_APIC_DISP, &D, 4);
  Cave[KPAT_OFF_XOFIX] = (mEferState == 1 || mEferState == 2) ? 1 : 0;
  D = (INT32)((INT64)mKpatCaveRva - (INT64)(mKpatEntryRva + 5));
  Base[mKpatEntryRva] = 0xE9;
  CopyMem (Base + mKpatEntryRva + 1, &D, 4);
  SetMem (Base + mKpatEntryRva + 5, KPAT_MOVED - 5, 0x90);
  mKstubBase = (UINT64)(UINTN)Base;
  mKpatUsed = TRUE;
  mKpatWhy = 0;
  return EFI_SUCCESS;
}

// The table stub when this kernel is in the table, else the pattern stub. KSTUB_FORCE_PATTERN (VM tests): pattern only.
STATIC EFI_STATUS KstubInstallAny (VOID)
{
#ifdef KSTUB_DISABLED
  if (!mKpatUsed) return EFI_ABORTED;        // measurement build (KSTUB_OFF=1): no kernel stub; the installers stay referenced
#endif
#ifndef KSTUB_FORCE_PATTERN
  EFI_STATUS St = KstubInstall ();
  if (St != EFI_NOT_FOUND) return St;
#else
  if (mKpatUsed) (VOID)KstubInstall ();       // never runs; keeps the table installer referenced in this build
#endif
  return KpatInstall ();
}
